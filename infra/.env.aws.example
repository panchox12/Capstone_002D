# Copiar como .env.aws en la EC2 y completar. El .env.aws nunca se sube al repositorio.

# Aplicacion
APP_NOMBRE=Cachai
# Mientras no esten los correos con SES, "desarrollo" deja el enlace de
# confirmacion en los registros: docker logs cachai_api
APP_ENTORNO=desarrollo
APP_DEBUG=false

# Base de datos: el punto de enlace de RDS (Connectivity & security > Endpoint)
DATABASE_URL=postgresql+psycopg://cachai:CONTRASENA_RDS@cachai-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/cachai

# Redis corre en el contenedor de al lado
REDIS_URL=redis://redis:6379/0

# Seguridad: dos claves nuevas, distintas de las de desarrollo
SECRET_KEY=
ALGORITMO_JWT=HS256
MINUTOS_EXPIRACION_TOKEN=60
SAL_DOCUMENTO=

# Verificacion de identidad: Rekognition en la cuenta AWS1
PROVEEDOR_IDENTIDAD=aws
REKOGNITION_REGION=us-east-1
REKOGNITION_ACCESS_KEY_ID=
REKOGNITION_SECRET_ACCESS_KEY=

# Videollamada
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Buscador semantico
PROVEEDOR_EMBEDDINGS=local

# Direccion del frontend en CloudFront (sin / al final): CORS y enlaces de los correos
URL_FRONTEND=https://dxxxxxxxxxxxxx.cloudfront.net

# Procesos programados
PLANIFICADOR_ACTIVO=true