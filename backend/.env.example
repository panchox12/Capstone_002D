# Aplicacion
APP_NOMBRE=Cachai
APP_ENTORNO=desarrollo
APP_DEBUG=true

# Base de datos
DATABASE_URL=postgresql+psycopg://cachai:cachai_local@localhost:5432/cachai

# Cache
REDIS_URL=redis://localhost:6379/0

# Seguridad
SECRET_KEY=reemplazar_por_una_clave_generada
ALGORITMO_JWT=HS256
MINUTOS_EXPIRACION_TOKEN=60

# Verificacion de identidad
SAL_DOCUMENTO=reemplazar_por_una_clave_generada
PROVEEDOR_IDENTIDAD=simulado
# Solo se usan con PROVEEDOR_IDENTIDAD=aws
REKOGNITION_REGION=us-east-1
REKOGNITION_ACCESS_KEY_ID=
REKOGNITION_SECRET_ACCESS_KEY=

# Frontend
URL_FRONTEND=http://localhost:5173

# Buscador semantico: simulado (sin descargas) o local (modelo multilingue)
PROVEEDOR_EMBEDDINGS=local

# Procesos programados
PLANIFICADOR_ACTIVO=true